{
  "name": "agora",
  "version": "0.0.0",
  "private": true,
  "description": "The Agora documentation site \u2014 a unified, AdonisJS-themed docs hub that syncs each library's docs.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "check:links": "node scripts/check-links.mjs --strict",
    "sync:docs:local": "AGORA_DOCS_LOCAL=1 node scripts/sync-docs.mjs",
    "predev": "AGORA_DOCS_LOCAL=1 node scripts/sync-docs.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-docs.mjs && node scripts/check-links.mjs --strict",
    "build": "next build",
    "start": "serve out",
    "lint": "biome check",
    "format": "biome format --write",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "16.15.4",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "postcss": "8.5.26",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
