{
  "name": "end-to-end",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.6.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "1.5.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.4.0",
    "@poppinss/ts-exec": "1.5.1",
    "@types/alpinejs": "3.17.0",
    "@types/luxon": "3.7.6",
    "@types/node": "25.9.9",
    "alpinejs": "3.17.5",
    "eslint": "10.13.0",
    "hot-hook": "1.0.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "youch": "4.1.1"
  },
  "dependencies": {
    "@adonis-agora/authkit-client": "0.20.3",
    "@adonis-agora/authkit-server": "0.86.0",
    "@adonis-agora/authz": "0.19.1",
    "@adonis-agora/context": "0.7.1",
    "@adonis-agora/media": "0.26.2",
    "@adonis-agora/telescope": "0.23.0",
    "@adonis-agora/telescope-ui": "1.5.2",
    "@adonisjs/core": "7.6.0",
    "@adonisjs/drive": "4.0.0",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/session": "8.3.0",
    "@adonisjs/shield": "9.0.0",
    "@adonisjs/static": "2.0.1",
    "@adonisjs/vite": "6.0.4",
    "@vinejs/vine": "4.4.0",
    "better-sqlite3": "13.0.3",
    "edge.js": "6.5.1",
    "luxon": "3.7.2",
    "reflect-metadata": "0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}