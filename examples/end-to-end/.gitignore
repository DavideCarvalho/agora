# Dependencies and AdonisJS build. Everything under tmp/ is ignored EXCEPT
# a placeholder that keeps the directory itself present after a fresh clone
# — config/database.ts's SQLite file lives at tmp/db.sqlite3, and
# better-sqlite3 refuses to create it if the directory doesn't exist yet.
node_modules
build
tmp/*
!tmp/.gitkeep

# Local media storage (config/drive.ts's "fs" disk — uploaded files land here)
storage

# Secrets
.env
.env.local
.env.production.local
.env.development.local

# Frontend assets compiled code
public/assets

# Build tools specific
npm-debug.log
yarn-error.log

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store
