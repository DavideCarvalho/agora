TZ=UTC
PORT=3333
HOST=localhost
APP_URL=http://${HOST}:${PORT}
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

# The model: scripted (default: offline, deterministic), openai:<model> or openrouter:<model>.
#   AGENT_MODEL=openai:gpt-4.1-mini                  + OPENAI_API_KEY
#   AGENT_MODEL=openrouter:openai/gpt-4.1-mini       + OPENROUTER_API_KEY (https://openrouter.ai/keys)
#   AGENT_MODEL=openrouter:anthropic/claude-sonnet-4.5
AGENT_MODEL=scripted
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Hosts Vite's dev server answers besides localhost, comma-separated. A leading dot matches every
# subdomain: `.ts.net` serves the app over a Tailscale tailnet (MagicDNS names). `true` = any host.
VITE_ALLOWED_HOSTS=
# Behind a proxy (tailscale serve, an HTTPS tunnel): where the browser reaches Vite's HMR websocket
# (it listens on its own port, 24678 — forward it too). See the README.
#   VITE_HMR_PROTOCOL=wss
#   VITE_HMR_CLIENT_PORT=24678
#   VITE_HMR_HOST=           (default: the page's host; Vite also listens on it)
#   VITE_HMR_PORT=           (the port Vite's HMR server listens on; default 24678)
#   VITE_HMR_LISTEN_HOST=127.0.0.1  (listen there only, so a proxy can hold the same port elsewhere)
