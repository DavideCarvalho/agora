<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrfToken }}">
    <title>{{ title }}</title>
    @viteReactRefresh()
    @vite(['resources/css/app.css', entry])
    @if(localCss)
      {{-- SANDBOX_KIT=<name>: a local kit's stylesheet, after the app's, so its theme wins. --}}
      @vite([localCss])
    @end
  </head>
  <body>
    <div id="root"></div>
  </body>
</html>
